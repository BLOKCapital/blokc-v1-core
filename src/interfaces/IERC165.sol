/// @title IERC165
/// @author OpenZeppelin
/// @notice Interface of the ERC-165 standard for contract interface detection.
/// @dev See https://eips.ethereum.org/EIPS/eip-165.
interface IERC165 {
    /// @notice Queries whether the contract implements a given interface.
    /// @dev Interface identification is specified in ERC-165. This function uses less than 30,000 gas.
    /// @param interfaceId The four-byte interface identifier, as specified in ERC-165.
    /// @return `true` if the contract implements `interfaceId`, `false` otherwise.
    function supportsInterface(bytes4 interfaceId) external view returns (bool);
}
