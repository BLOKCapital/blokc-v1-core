/// @title IIndex
/// @author BLOK Capital DAO
/// @notice Interface for an Index contract that exposes component asset weights.
interface IIndex {
    /// @notice Returns the current normalized weights for each asset in the index.
    /// @return weights Array of asset weights (normalized to 1e18 = 100%).
    function getAssetWeights() external view returns (uint256[] memory weights);
}
